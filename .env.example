# ─────────────────────────────────────────────────────────────────────────────
# ReelPulse — Live Facebook scrape (server-side)
#
# Copy to `.env` for local `vercel dev`, or add through the Vercel dashboard
# (Project → Settings → Environment Variables). Secrets never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Which upstream scrapes Facebook. `apify` (recommended) or `rapidapi`.
SCRAPE_VIA=apify

# ── Apify (primary route) ────────────────────────────────────────────────────
# Apify API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Facebook Reels actors on the Apify Store. The default below returns caption,
# hashtags, audio, video files and per-reel metrics for public pages.
APIFY_ACTOR_ID=dami_studio/facebook-reels-scraper
# Optional: full actor input JSON (startUrls/resultsLimit are injected unless
# present here). Example: {"proxyConfiguration":{"useApifyProxy":true}}
APIFY_ACTOR_INPUT={"proxyConfiguration":{"useApifyProxy":true}}

# ── RapidAPI (secondary route) ───────────────────────────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_FACEBOOK_HOST=facebook-scraper7.p.rapidapi.com

# ── Scrape scope ────────────────────────────────────────────────────────────
# Tracked public Facebook pages (URL or bare handle). The admin UI can send a
# per-user pages override; env decides when it stays blank. JSON array works
# in dotenv (a newline-separated list works too when set via the Vercel dashboard).
FB_PAGES=["https://www.facebook.com/9gag","https://www.facebook.com/NatGeo","https://www.facebook.com/Tasty"]
https://www.facebook.com/StuffLtd

# Reels scraped per page per run (1–200).
RESULTS_LIMIT=30

# How long a snapshot stays fresh before the next request triggers a refresh.
SNAPSHOT_TTL_MINUTES=5

# Optional shared secret: when set, requests must send `x-reelpulse-key: <value>`
# (header) or ?key=<value> (query). Keeps strangers from burning scrape credits.
SNAPSHOT_ACCESS_KEY=
